{
  "manifest_version": 3,
  "name": "T68k Browser Helix",
  "version": "1.0.0",
  "description": "Modal, selection-first, which-key powered browser navigation inspired by Helix Editor",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "history",
    "bookmarks",
    "sessions",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "T68k Browser Helix",
    "default_icon": {
      "16": "src/assets/icon16.png",
      "48": "src/assets/icon48.png",
      "128": "src/assets/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Open T68k Browser Helix Options / Focus"
    }
  },
  "icons": {
    "16": "src/assets/icon16.png",
    "48": "src/assets/icon48.png",
    "128": "src/assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/styles/helix.css",
        "src/assets/icon16.png",
        "src/assets/icon48.png",
        "src/assets/icon128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "t68k-browser-helix@local",
      "strict_min_version": "121.0"
    }
  }
}